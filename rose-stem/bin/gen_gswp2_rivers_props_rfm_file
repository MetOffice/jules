###############################################################################
# This script writes a GSWP2 rivers props file list compatible with the
# version of JULES in which it is present
#
# The path to the data is given by the environment variable
# $GSWP2_INSTALL_DIR
#
# The Rivers ancillary file list is written to rivers_props_rfm_file_list.txt
# in the current directory
###############################################################################

tee rivers_props_rfm_file_list.txt > /dev/null <<EOF
'$GSWP2_INSTALL_DIR/ancil/qrparm.trip.nc'
'$GSWP2_INSTALL_DIR/ancil/river_number_trip.nc'
EOF
