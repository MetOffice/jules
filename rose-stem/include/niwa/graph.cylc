###############################################################################
## Imports
###############################################################################
%include 'include/niwa/graph-cs500.cylc'
%include 'include/niwa/graph-xc50.cylc'

###############################################################################
## Name graphs
###############################################################################
{%- set name_graphs = {
        "umdp3_check"       : "export_source => umdp3_checker",
        "metadata_check"       : "export_source => metadata_checker",
        "site_validator" : "export_source => site_validator",
} %}
{%- do name_graphs.update(name_graphs_cs500.items()) %}
{%- do name_graphs.update(name_graphs_xc50.items()) %}

###############################################################################
## Group definitions
###############################################################################

{%- set groups = {

        "all" : ["niwa_cs500_all", "niwa_xc50_all", "scripts"],

        "tutorial" : ["niwa_xc50_intel_loobos_crops"],

        "scripts"   : ["umdp3_check", "metadata_check", "site_validator"],

    }
%}
{%- do groups.update(groups_cs500.items()) %}
{%- do groups.update(groups_xc50.items()) %}
