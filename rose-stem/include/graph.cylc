###############################################################################
## Import site-specific graphs
##
## These files should set the name_graphs and groups variables
###############################################################################
{% if REMOTE_JASMIN %}
%include 'include/jasmin/graph.cylc'
{% else %}
{% if SITE == 'meto' %}
%include 'include/meto/graph.cylc'
{% elif SITE == 'vm' %}
%include 'include/vm/graph.cylc'
{% elif SITE == 'jasmin' %}
%include 'include/jasmin/graph.cylc'
{% elif SITE == 'esnz' %}
%include 'include/esnz/graph.cylc'
{% elif SITE == 'cehwl1' %}
%include 'include/cehwl1/graph.cylc'
{% elif SITE == 'nci' %}
%include 'include/nci/graph.cylc'
{% elif SITE == 'bom' %}
%include 'include/bom/graph.cylc'
{% endif %}
{% endif %}
