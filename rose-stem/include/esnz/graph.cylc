###############################################################################
## Imports
###############################################################################
%include 'include/esnz/graph-cascade.cylc'

###############################################################################
## Name graphs
###############################################################################
{%- set name_graphs = {
        "umdp3_check"    : "extract_source => umdp3_checker",
        "metadata_check" : "extract_source => metadata_checker",
        "site_validator" : "extract_source => site_validator",
} %}
{%- do name_graphs.update(name_graphs_cascade.items()) %}

###############################################################################
## Group definitions
###############################################################################

{%- set groups = {

        "all" : ["esnz_cascade_all", "scripts"],

        "tutorial" : ["esnz_cascade_ifx_loobos_crops"],

        "scripts"   : ["umdp3_check", "metadata_check", "site_validator"],

    }
%}
{%- do groups.update(groups_cascade.items()) %}
