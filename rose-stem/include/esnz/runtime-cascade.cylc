        [[[environment]]]
            ROSE_TASK_APP = gswp2_rivers
            ROSE_APP_OPT_CONF_KEYS = overbank_hypso

    [[esnz_cascade_ifx_gswp2_trip_rivers-only]]
        pre-script = gen_gswp2_rivers_props_trip_file
        inherit = ESNZ_CASCADE_GSWP2
        [[[environment]]]
            ROSE_TASK_APP = gswp2_trip
 	    ROSE_APP_COMMAND_KEY = rivers-only
            ROSE_APP_OPT_CONF_KEYS = rivers-only
            RIVERS_ONLY_INSTALL_DIR = ../esnz_cascade_ifx_gswp2_trip/output
            RIVERS_ONLY_DRIVE_TASK = esnz_cascade_ifx_gswp2_trip

    [[esnz_cascade_ifx_gswp2_trip_restart_rivers-only_lrun]]
        inherit = ESNZ_CASCADE_GSWP2_TRIP_RESTART_RIVERS_ONLY

    [[esnz_cascade_ifx_gswp2_trip_restart_rivers-only_nrun1]]
        inherit = ESNZ_CASCADE_GSWP2_TRIP_RESTART_RIVERS_ONLY
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = rivers-only nrun1

    [[esnz_cascade_ifx_gswp2_trip_restart_rivers-only_nrun2]]
        inherit = ESNZ_CASCADE_GSWP2_TRIP_RESTART_RIVERS_ONLY
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = rivers-only nrun2
            DUMP_FILE = ../esnz_cascade_ifx_gswp2_trip_restart_rivers-only_nrun1/output/esnz_cascade_ifx_gswp2_trip_restart_rivers-only_nrun1.dump.19820704.10800.nc

# For GSWP2 trip restart init storage, use MPI
    [[esnz_cascade_ifx_gswp2_trip_restart_init_storage]]
        pre-script = gen_gswp2_rivers_props_trip_file_init_storage
        inherit = ESNZ_CASCADE_GSWP2_TRIP_RESTART, ESNZ_CASCADE_CORES_32
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = rivers-init-storage

    [[esnz_cascade_ifx_gswp2_gl7_flanner]]
        inherit = ESNZ_CASCADE_GSWP2
        [[[environment]]]
            ROSE_TASK_APP = gswp2_gl7
            ROSE_APP_OPT_CONF_KEYS = flanner

    [[GSWP2_UKV_IFX]]
        [[[environment]]]
            EXT_NAME = esnz_cascade_ifx_gswp2_ukv
            ROSE_TASK_APP = gswp2_ukv
            ROSE_APP_OPT_CONF_KEYS=threading

    [[esnz_cascade_ifx_gswp2_ukv_noomp]]
        inherit = ESNZ_CASCADE_GSWP2, GSWP2_UKV_IFX
        [[[environment]]]
            BUILD_NAME = fcm_make_esnz_cascade_ifx_noomp

    [[esnz_cascade_ifx_gswp2_ukv_8_omp_threads]]
        inherit = ESNZ_CASCADE_GSWP2, GSWP2_UKV_IFX

    [[esnz_cascade_ifx_gswp2_ukv_omp_flake]]
        inherit = ESNZ_CASCADE_GSWP2, GSWP2_UKV_IFX
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = flake


    [[esnz_cascade_ifx_gswp2<gswp2_single>]]
        inherit = ESNZ_CASCADE_GSWP2
        [[[environment]]]
            ROSE_TASK_APP = gswp2_${CYLC_TASK_PARAM_gswp2_single}

# ToDo - Missing input file "river_number_trip.nc"
    [[esnz_cascade_ifx_gswp2<gswp2_single=rivers>]]
        script = true
        pre-script = gen_gswp2_rivers_props_rfm_file
        inherit = ESNZ_CASCADE_GSWP2
        [[[environment]]]
            ROSE_TASK_APP = gswp2_rivers

# ToDo - Missing input file "river_number_trip.nc"
