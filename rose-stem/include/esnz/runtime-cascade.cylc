                     . /opt/niwa/profile/conda_24.11.3_2025.05.1.sh
                     conda activate niwa_tools_2025.07.1
                     """
        [[[environment]]]
            CMD_CMP = nccmp -d --force
            KGO_DIR = /esi/project/niwa00001/rose-stem/jules/rose-stem-kgo/{{ KGO_VERSION }}

