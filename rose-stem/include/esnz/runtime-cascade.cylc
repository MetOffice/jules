        [[[environment]]]
            ROSE_TASK_APP = gswp2_trip

    [[esnz_cascade_ifx_gswp2<gswp2_with_spinup>_spinup]]
        inherit = ESNZ_CASCADE_GSWP2
        [[[environment]]]
            ROSE_TASK_APP = gswp2_${CYLC_TASK_PARAM_gswp2_with_spinup}_spinup

    [[esnz_cascade_ifx_gswp2<gswp2_with_spinup>_restart]]
