###############################################################################
## Build jobs
###############################################################################
# Override SCRIPTS family.
# (normally found in runtime-common.rc, Done to enforce loading of
# Python 3 on JASMIN which is required by UMDP3 checker)
    [[SCRIPTS]]
            env-script = "module load jaspy/3.7/r20210320"

{% if REMOTE_JASMIN  %}
    [[REMOTE]]
        submission polling intervals = PT1M
        execution polling intervals = PT1M
        [[[remote]]]
            owner = {{ JASMIN_USER_ID }}
{% else %}
     [[REMOTE]]
{% endif %}


    [[JASMIN_LOTUS]]
        inherit = REMOTE
        env-script = """
                eval $(rose task-env)
                module load oneapi/compilers/24.2.0
                module load oneapi/mpi/24.2.0
                module load netcdf/intel2024.2.0/4.9.2
                module load netcdf/intel2024.2.0/fortran/4.6.1
                export HDF5_LIBDIR=/apps/jasmin/supported/libs/hdf5/intel2024.2.0/1.14.4-2/lib
                export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:$HDF5_LIBDIR
                export NETCDF_FORTRAN_ROOT=/apps/jasmin/supported/libs/netcdf/intel2024.2.0/fortran/4.6.1
                module list 2>&1
                """

        [[[job]]]
            batch system = slurm
        [[[directives]]]
            --account = jules
            --qos = debug
            --partition = debug
        [[[environment]]]
            ROSE_LAUNCHER = srun

        {% if JASMIN_JULES_BASE_DIR is defined %}
            JASMIN_JULES_BASE_DIR = {{JASMIN_JULES_BASE_DIR}}
        {% else %}
            JASMIN_JULES_BASE_DIR = "/gws/nopw/j04/jules"
        {% endif %}
            JASMIN_ROSE_STEM_DATA_DIR = $JASMIN_JULES_BASE_DIR/admin

    [[remote_init_jasmin]]
        inherit = JASMIN_LOTUS
        script = true
        [[[job]]]
            execution time limit = PT2M

    [[JASMIN_FCM_MAKE]]
        inherit = None, JASMIN_LOTUS, EXTRACT
        [[[environment]]]
            JULES_PLATFORM = jasmin-lotus-intel
            {% if REMOTE_JASMIN %}
                JULES_SOURCE = {{ REMOTE_JULES_SOURCE }}
            {% else %}
                JULES_SOURCE = {{ SOURCE_JULES }}
            {% endif %}
        [[[job]]]
            execution time limit = PT20M
        [[[directives]]]
            --ntasks = 1

    [[fcm_make_debug]]
        inherit = None, JASMIN_FCM_MAKE
        [[[environment]]]
            JULES_BUILD = normal
            JULES_OMP   = noomp

    [[fcm_make_mpi]]
        inherit = None, JASMIN_FCM_MAKE
        [[[environment]]]
            JULES_BUILD = normal
            JULES_OMP   = noomp

    [[fcm_make_mpi_rivers-only]]
        inherit = None, JASMIN_FCM_MAKE, EXTRACT_RIVER
        [[[environment]]]
            JULES_BUILD = normal
            JULES_OMP   = noomp

###############################################################################
## Compute jobs
###############################################################################
    [[JASMIN_COMPUTE]]
        inherit = None, JASMIN_LOTUS, COMPUTE
        [[[job]]]
            execution time limit = PT30M

        [[[environment]]]
            LOOBOS_INSTALL_DIR = $JASMIN_ROSE_STEM_DATA_DIR/loobos_data
            GSWP2_INSTALL_DIR = $JASMIN_ROSE_STEM_DATA_DIR/benchmarking-data/gswp2
            ERAINT_INSTALL_DIR = $JASMIN_ROSE_STEM_DATA_DIR/benchmarking-data/eraint
            IMOGEN_INSTALL_DIR = $JASMIN_ROSE_STEM_DATA_DIR/benchmarking-data/imogen
            LD_LIBRARY_PATH = $LD_LIBRARY_PATH:$HDF5_LIBDIR

    [[JASMIN_LOOBOS]]
        inherit = None, JASMIN_COMPUTE
        [[[directives]]]
            --ntasks = 1
        [[[environment]]]
            BUILD_NAME = fcm_make_debug

