    [[METO_AZSPICE_GNU_GSWP2]]
{%- if COVERAGE == true %}
        inherit = GSWP2, METO_AZSPICE_COMPUTE, METO_AZSPICE_1_TASK, METO_AZSPICE_1_THREAD
{%- else %}
        inherit = GSWP2, METO_AZSPICE_COMPUTE, METO_AZSPICE_8_TASKS, METO_AZSPICE_1_THREAD
{%- endif %}
        pre-script = gen_gswp2_drive_file
        [[[environment]]]
{%- if COVERAGE == true %}
            BUILD_NAME = fcm_make_meto_azspice_gnu_coverage
{%- else %}
            BUILD_NAME = fcm_make_meto_azspice_gnu_omp_mpi
{%- endif %}
	[[[directives]]]
	    --mem = 2048

    [[METO_AZSPICE_GNU_GSWP2_RIVERS_ONLY]]
        inherit = METO_AZSPICE_GNU_GSWP2, METO_AZSPICE_8_TASKS
        [[[environment]]]
	        BUILD_NAME = fcm_make_meto_azspice_gnu_rivers-only_omp_mpi
	        ROSE_APP_COMMAND_KEY = rivers-only

    [[METO_AZSPICE_GNU_GSWP2_RFM_RESTART]]
        pre-script = gen_gswp2_rivers_props_rfm_file
        inherit = METO_AZSPICE_GNU_GSWP2
        [[[environment]]]
            ROSE_TASK_APP = gswp2_rivers_restart
            DUMP_FILE = ../meto_azspice_gnu_gswp2_rivers_spinup/output/meto_azspice_gnu_gswp2_rivers_spinup.dump.19820701.10800.nc

    [[METO_AZSPICE_GNU_GSWP2_RFM_RESTART_RIVERS_ONLY]]
        inherit = METO_AZSPICE_GNU_GSWP2_RFM_RESTART, METO_AZSPICE_GNU_GSWP2_RIVERS_ONLY
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = rivers-only
	        RIVERS_ONLY_INSTALL_DIR = ../meto_azspice_gnu_gswp2_rivers_restart/output
	        RIVERS_ONLY_DRIVE_TASK = meto_azspice_gnu_gswp2_rivers_restart

    [[METO_AZSPICE_GNU_GSWP2_TRIP_RESTART]]
        pre-script = gen_gswp2_rivers_props_trip_file
        inherit = METO_AZSPICE_GNU_GSWP2
        [[[environment]]]
            ROSE_TASK_APP = gswp2_trip_restart
            DUMP_FILE = ../meto_azspice_gnu_gswp2_trip_spinup/output/meto_azspice_gnu_gswp2_trip_spinup.dump.19820701.10800.nc

    [[METO_AZSPICE_GNU_GSWP2_TRIP_RESTART_RIVERS_ONLY]]
        inherit = METO_AZSPICE_GNU_GSWP2_TRIP_RESTART, METO_AZSPICE_GNU_GSWP2_RIVERS_ONLY
        [[[environment]]]
            ROSE_APP_OPT_CONF_KEYS = rivers-only
	        RIVERS_ONLY_INSTALL_DIR = ../meto_azspice_gnu_gswp2_trip_restart/output
	        RIVERS_ONLY_DRIVE_TASK = meto_azspice_gnu_gswp2_trip_restart

    [[METO_AZSPICE_GNU_ERAINT]]
{%- if COVERAGE == true %}
        inherit = ERAINT, METO_AZSPICE_COMPUTE, METO_AZSPICE_1_TASK, METO_AZSPICE_1_THREAD
{%- else %}
        inherit = ERAINT, METO_AZSPICE_COMPUTE, METO_AZSPICE_8_TASKS, METO_AZSPICE_1_THREAD
