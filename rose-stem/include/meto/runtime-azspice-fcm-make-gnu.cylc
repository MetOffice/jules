###############################################################################
## Build jobs
###############################################################################
# Linux gnu build jobs
    [[METO_AZSPICE_GNU_BUILD]]
        inherit = METO_AZSPICE_BUILD

    [[METO_AZSPICE_GNU_BUILD_MPI]]
        inherit = METO_AZSPICE_GNU_BUILD
        pre-script = """
                     module purge
                     module load csc/2025.11.19
                     module load gcc/12.2.0
                     module load mpich/4.2.3
                     module load eccodes/2.34.0
                     module load netcdf-fortran/4.6.1
                     module list 2>&1
                     """

    [[METO_AZSPICE_GNU_BUILD_NOMPI]]
        inherit = METO_AZSPICE_GNU_BUILD
        pre-script = """
                     module purge
                     module load csc/2025.11.19
                     module load gcc/12.2.0
                     module load mpich/4.2.3
                     module load eccodes/2.34.0
                     module load netcdf-fortran/4.6.1
                     module list 2>&1
                     """

# Linux gnu River.Exe build jobs
    [[METO_AZSPICE_GNU_BUILD_RIVERS_ONLY_MPI]]
        inherit = METO_AZSPICE_BUILD_RIVERS_ONLY,METO_AZSPICE_GNU_BUILD_MPI

{%- if COVERAGE == true %}
    [[fcm_make_meto_azspice_gnu_coverage]]
        inherit = METO_AZSPICE_GNU_BUILD_NOMPI
        pre-script = mkdir -p $CYLC_SUITE_SHARE_DIR/coverage
        [[[environment]]]
            JULES_PLATFORM = meto-azspice-gnu-nompi
            JULES_BUILD = normal
            JULES_OMP = noomp
            JULES_FFLAGS_EXTRA  = -prof-gen=srcpos -prof-dir $CYLC_SUITE_SHARE_DIR/coverage
            JULES_LDFLAGS_EXTRA = -prof-gen=srcpos -prof-dir $CYLC_SUITE_SHARE_DIR/coverage
{%- else %}
    [[fcm_make_meto_azspice_gnu_debug_noomp_nompi]]
        inherit = METO_AZSPICE_GNU_BUILD_NOMPI
        [[[environment]]]
            JULES_PLATFORM = meto-azspice-gnu-nompi
            JULES_BUILD = debug
            JULES_OMP = noomp

    [[fcm_make_meto_azspice_gnu_omp_nompi]]
        inherit = METO_AZSPICE_GNU_BUILD_NOMPI
        [[[environment]]]
            JULES_PLATFORM = meto-azspice-gnu-nompi
            JULES_BUILD = normal
            JULES_OMP = omp

    [[fcm_make_meto_azspice_gnu_noomp_mpi]]
        inherit = METO_AZSPICE_GNU_BUILD_MPI
        [[[environment]]]
            JULES_PLATFORM = meto-azspice-gnu-mpi
            JULES_BUILD = normal
            JULES_OMP = noomp

    [[fcm_make_meto_azspice_gnu_omp_mpi]]
        inherit = METO_AZSPICE_GNU_BUILD_MPI
        [[[environment]]]
            JULES_PLATFORM = meto-azspice-gnu-mpi
            JULES_BUILD = normal
            JULES_OMP = omp

    [[fcm_make_meto_azspice_gnu_rivers-only_noomp_mpi]]
        inherit = METO_AZSPICE_GNU_BUILD_RIVERS_ONLY_MPI
        [[[environment]]]
            JULES_PLATFORM = meto-azspice-gnu-mpi
            JULES_BUILD = normal
            JULES_OMP = noomp
            SOURCE_PATH_PREFIX = river

    [[fcm_make_meto_azspice_gnu_rivers-only_omp_mpi]]
        inherit = METO_AZSPICE_GNU_BUILD_RIVERS_ONLY_MPI
        [[[environment]]]
            JULES_PLATFORM = meto-azspice-gnu-mpi
            JULES_BUILD = normal
            JULES_OMP = omp
            SOURCE_PATH_PREFIX = river
{%- endif %}

###############################################################################
## Compute jobs
###############################################################################
# Family for Loobos jobs with the gnu compiler
    [[METO_AZSPICE_GNU_LOOBOS]]
        inherit = LOOBOS, METO_AZSPICE_COMPUTE, METO_AZSPICE_1_TASK, METO_AZSPICE_1_THREAD
        [[[environment]]]
{%- if COVERAGE == true %}
            BUILD_NAME = fcm_make_meto_azspice_gnu_coverage
{%- else %}
            BUILD_NAME = fcm_make_meto_azspice_gnu_debug_noomp_nompi
            {# BUILD_NAME = fcm_make_meto_azspice_gnu_omp_mpi #}
{%- endif %}

