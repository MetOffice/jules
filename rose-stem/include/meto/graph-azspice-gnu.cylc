							  housekeep_meto_azspice_gnu_gswp2_rivers_restart_rivers-only_nrun2",
    }
%}

# If coverage stats are requested, make sure the coverage generation will be run
{%- if COVERAGE == true %}
    # Add the coverage graph to name_graphs
    {%- do name_graphs_azspice_gnu.update({
            "meto_azspice_gnu_coverage" : "METO_AZSPICE_GNU_LOOBOS:succeed-all & METO_AZSPICE_GNU_GSWP2:succeed-all & METO_AZSPICE_GNU_ERAINT:succeed-all & METO_AZSPICE_GNU_IMOGEN:succeed-all => coverage_summary"
        })
    %}

    # Add the coverage group to RUN_NAMES
    {%- do RUN_NAMES.append("meto_azspice_gnu_coverage") %}
{%- else %}
    {%- do name_graphs_azspice_gnu.update(name_graphs_azspice_gnu_no_coverage.items()) %}
{%- endif %}


