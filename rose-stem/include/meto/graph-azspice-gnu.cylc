###############################################################################
## Name graphs
###############################################################################
{%- if COVERAGE == true %}
    # If coverage stats are requested, all gnu runs must use the same build in order for the
    # profiling stats to be generated and aggregated correctly
    {%- set loobos_build   = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_coverage" %}
    {%- set rivers_build   = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_coverage" %}
    {%- set closures_build = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_coverage" %}
    {%- set imogen_build   = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_coverage" %}
{%- else %}
    {%- set loobos_build    = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_debug_noomp_nompi" %}
    {%- set rivers_build    = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_omp_mpi" %}
    {%- set closures_build  = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_omp_mpi" %}
    {%- set imogen_build    = "remote_init_azspice => extract_source => fcm_make_meto_azspice_gnu_omp_mpi" %}
{%- endif %}

